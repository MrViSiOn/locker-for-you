# Copiar a .env para desarrollo local. NUNCA commitear el .env real.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Rutas de datos. En produccion son los volumenes Docker.
DB_DIR=./data/db
BLOBS_DIR=./data/blobs

# Limite por fichero en bytes (50 MB). Coordinar con client_max_body_size
# de nginx, que debe ir por encima: 60 MB (DRAPPS-1035).
MAX_FILE_SIZE=52428800

# Detras de un reverse proxy debe quedar en true, o el rate limit por IP
# vera siempre 127.0.0.1 y no servira de nada (DRAPPS-1043).
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# SALT_PEPPER — OBLIGATORIA EN PRODUCCION (el servidor no arranca sin ella)
#
# Con ella se construye el salt falso que se devuelve para emails que no
# existen, de modo que /auth/challenge no sirva para averiguar quien tiene
# cuenta. Si cambiara entre reinicios, el salt de un email inexistente
# cambiaria con ella, y comparar dos respuestas separadas por un reinicio
# revelaria justo lo que se quiere ocultar.
#
# Generar UNA vez y no volver a tocarla:
#   openssl rand -base64 32
#
# En desarrollo se genera sola al arrancar y no hace falta ponerla.
# ---------------------------------------------------------------------------
SALT_PEPPER=

# ---------------------------------------------------------------------------
# TOTP_KEY — OBLIGATORIA EN PRODUCCION
#
# Cifra el secreto del segundo factor en la base de datos. Quien vuelque la
# BD sin tener tambien este .env no puede generar codigos.
#
# Si se pierde, el segundo factor deja de validar y hay que volver a
# configurarlo desde cero. Los FICHEROS NO se ven afectados: esta clave no
# cifra nada de la boveda.
#
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
TOTP_KEY=
